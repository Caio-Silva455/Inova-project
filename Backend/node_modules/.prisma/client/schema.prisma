generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("cuidador") // "admin" | "cuidador"
  createdAt DateTime @default(now())

  idosos Idoso[]

  @@map("Users")
}

model Idoso {
  id             Int       @id @default(autoincrement())
  nome           String
  dataNascimento DateTime?
  endereco       String?
  responsavelId  Int
  responsavel    User      @relation(fields: [responsavelId], references: [id])
  createdAt      DateTime  @default(now())

  alertas Alerta[]

  @@map("Idosos")
}

model Alerta {
  id         Int      @id @default(autoincrement())
  idosoId    Int
  idoso      Idoso    @relation(fields: [idosoId], references: [id])
  tipo       String // "queda" | "frequencia_baixa" | "frequencia_alta" | "fora_da_area"
  severidade String // "baixa" | "media" | "alta"
  dados      String?  @db.NVarChar(Max) // JSON serializado — SQL Server não tem tipo Json nativo
  lido       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("Alertas")
}
